# Projet Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : SERVEUR UNIQUEMENT, ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Notifications push (générer avec : npx web-push generate-vapid-keys)
# Sans ces clés, l'app fonctionne normalement, juste sans notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:president@exemple.fr
